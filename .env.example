ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=

# VibeVoice (optional — only needed if using --tts vibevoice)
# Path to your cloned vibevoice-community/VibeVoice repo
VIBEVOICE_REPO=
# Voice to use (default: Maya). Options: Alice, Carter, Frank, Mary, Maya
VIBEVOICE_SPEAKER=Maya
# Model to use (default: microsoft/VibeVoice-1.5B)
VIBEVOICE_MODEL=microsoft/VibeVoice-1.5B
